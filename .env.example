# Arc testnet deployment settings for contracts/scripts/deploy.js
# Copy this file to .env and fill in your own values.

# Arc RPC endpoint for testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Private key used to deploy the contract
DEPLOYER_PRIVATE_KEY=0xyourprivatekeyhere

# Operator address used by the escrow contract to resolve matches
OPERATOR_ADDRESS=0xyouroperatoraddress

# Treasury address that receives protocol fees (optional)
TREASURY_ADDRESS=0xyourtreasuryaddress

# Fee basis points (max 500 = 5%)
FEE_BPS=200
